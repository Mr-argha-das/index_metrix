# ============================================================
# BOT INDEXER environment
# Copy to .env and adjust. Never commit .env.
# ============================================================

APP_NAME=INDEX MATRIX
APP_ENV=development
# development | production | test

# Public URL of THIS site (used for canonicals, sitemap, robots.txt, RSS)
PUBLIC_BASE_URL=https://v1.indexmetrix.com

# Long random secret: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME

# Initial admin (only used on first startup, when no users exist)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME

# Cookies: auto-detected by default (Secure; SameSite=None for HTTPS clients —
# required when the app is embedded cross-site, e.g. an HTTPS live-preview
# iframe — and SameSite=Lax for plain-HTTP local use).
# SECURE_CLIENT=true forces the HTTPS behaviour; COOKIE_SAMESITE=lax|none forces a mode.
SECURE_CLIENT=false
COOKIE_SAMESITE=

# Storage
DATA_DIR=data

# Fetching / SSRF
MAX_PDF_SIZE_MB=35
HTTP_TIMEOUT=30
CONNECT_TIMEOUT=10
MAX_REDIRECTS=5
FETCH_HOST_DELAY_SECONDS=1
FETCH_RATE_PER_MINUTE=10
FETCH_CONCURRENCY_PER_HOST=2
MAX_UPLOAD_MB=2
# TEST/DEV ONLY: allow loopback/private fetch targets. NEVER in production.
ALLOW_PRIVATE_TARGETS=false

# Queue
INDEXER_CONCURRENCY=2
MAX_RETRIES=3
POLLING_INTERVAL_MS=5000

# Publishing
RSS_ENABLED=true
SITEMAP_ENABLED=true

# Integrations (optional — leave disabled unless you have credentials)
GOOGLE_SEARCH_CONSOLE_ENABLED=false
# Path to a service-account JSON file, or the inline JSON itself.
# The service account needs the "webmasters" (Search Console) scope and
# must be a user of the Search Console property you want to inspect.
GOOGLE_SERVICE_ACCOUNT_JSON=

BING_WEBMASTER_ENABLED=false
BING_API_KEY=

# Non-authoritative search visibility observation (off by default)
OBSERVATION_ENABLED=false
